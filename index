<!DOCTYPE html>
<html>
<head>
  <base target="_top">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background:#f2f4f7; font-family:-apple-system,BlinkMacSystemFont,sans-serif; }
    .app-box { max-width: 600px; margin:auto; background:#fff; min-height:100vh; padding:20px; box-shadow:0 0 10px rgba(0,0,0,0.05); }
    .header { display:flex; align-items:center; gap:14px; padding-bottom:12px; border-bottom:2px solid #e0e0e0; }
    .main-title { font-size:20px; font-weight:700; color:#003366; }
    .sub-title { font-size:13px; color:#555; }
    .autocomplete-list li { cursor:pointer; font-size:15px; }
    .autocomplete-list li:hover { background:#f1f5ff; }
    .section-title { font-size:15px; font-weight:700; color:#003366; margin:22px 0 10px; padding-left:10px; border-left:4px solid #0d6efd; }
    .question-item { border:1px solid #e5e5e5; border-radius:10px; padding:15px; margin-bottom:15px; transition: border-color .15s; background:#fafafa; }
    .question-item.missing { border-color:#dc3545; background-color:#fff8f8; }
    .question-text { font-size:15px; font-weight:600; margin-bottom:12px; color:#212529; }
    .option-label { display:flex; align-items:center; padding:10px; border:1px solid #dee2e6; border-radius:8px; background:#fff; cursor:pointer; margin-bottom:8px; transition:0.2s; }
    .option-label:hover { background:#f8f9fa; }
    .option-label input[type="checkbox"] { width:18px; height:18px; margin-right:12px; }
    .question-hint { font-style: italic; color: #0d6efd; font-size: 13px; margin-top: 8px; }
    #quizWrap { display:none; }
  </style>
</head>
<body>

<div class="app-box">

  <div class="header">
    <div class="title">
      <div class="main-title">Ứng Dụng Thi Trắc Nghiệm</div>
      <div class="sub-title">Chọn nhiều đáp án đúng cho mỗi câu hỏi</div>
    </div>
  </div>

  <div class="mt-3">
    <label class="form-label fw-bold">Ngày làm bài</label>
    <input type="date" class="form-control form-control-lg" id="evalDate">
  </div>

  <div class="mt-3 position-relative">
    <label class="form-label fw-bold">Tên thí sinh</label>
    <input type="text" class="form-control form-control-lg" id="employee" placeholder="🔍 Gõ để tìm tên..." autocomplete="off">
    <ul id="employeeList" class="list-group position-absolute w-100 d-none autocomplete-list" style="z-index:1000; max-height:200px; overflow-y:auto;"></ul>
  </div>

  <div class="mt-3 position-relative">
    <label class="form-label fw-bold">Chủ đề / Đề thi</label>
    <input type="text" class="form-control form-control-lg" id="bulk" placeholder="🔍 Gõ để chọn chủ đề..." autocomplete="off">
    <ul id="bulkList" class="list-group position-absolute w-100 d-none autocomplete-list" style="z-index:1000; max-height:200px; overflow-y:auto;"></ul>
  </div>

  <div class="d-grid my-4">
    <button class="btn btn-primary btn-lg shadow-sm" id="btnLoadCriteria" onclick="loadQuestionsSection()">
      Bắt đầu làm bài
    </button>
  </div>

  <div id="quizWrap">
    <hr>
    <div id="questionsList"></div>
    <div class="d-grid my-3">
      <button class="btn btn-success btn-lg shadow-sm" id="btnSubmit" onclick="submitQuiz()">
        🚀 Nộp Bài Thi
      </button>
    </div>
  </div>

  <div id="loading" class="text-center my-3 d-none">
    <div class="spinner-border text-primary"></div>
    <div class="mt-2 text-muted">Đang tải câu hỏi/xử lý bài thi...</div>
  </div>

</div>

<script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
<script>
  // Thay URL Web App Apps Script của bạn vào đây
  const WEB_APP_URL = "https://script.google.com/macros/s/AKfycbyG447gVBArgX6iIb3tdkQ0vafODxPpAVYsGPUTBobPKc2Zxvghn0ofWuv2F4QI7mx2_A/exec";

  let questionsData = [];
  let employeesData = [];
  let bulksData = [];
  let userAnswers = {}; // Dạng: { 1: ['A', 'C'], 2: ['B'] }

  document.addEventListener("DOMContentLoaded", () => {
    document.getElementById("evalDate").value = new Date().toISOString().slice(0, 10);
    showLoading();
    const script = document.createElement("script");
    script.src = `${WEB_APP_URL}?action=getFormData&callback=handleFormData`;
    script.onerror = () => {
      hideLoading();
      swal("Lỗi Kết Nối", "Không thể lấy dữ liệu từ Google Sheets", "error");
    };
    document.body.appendChild(script);
  });

  function handleFormData(res) {
    hideLoading();
    if (res && res.status === "SUCCESS") {
      employeesData = res.data.employees || [];
      bulksData = res.data.bulks || [];
    }
  }

  function setupAutocomplete(inputId, listId, getData) {
    const input = document.getElementById(inputId);
    const list = document.getElementById(listId);
    input.addEventListener("input", () => {
      const keyword = input.value.toUpperCase().trim();
      list.innerHTML = "";
      const data = getData();
      if (!keyword || data.length === 0) { list.classList.add("d-none"); return; }
      const matched = data.filter(f => f.toUpperCase().includes(keyword));
      if (matched.length === 0) { list.classList.add("d-none"); return; }
      matched.forEach(f => {
        const li = document.createElement("li");
        li.className = "list-group-item";
        li.textContent = f;
        li.onclick = () => { input.value = f; list.classList.add("d-none"); };
        list.appendChild(li);
      });
      list.classList.remove("d-none");
    });
  }
  setupAutocomplete("employee", "employeeList", () => employeesData);
  setupAutocomplete("bulk", "bulkList", () => bulksData);

  document.addEventListener("click", e => {
    if (!e.target.closest(".position-relative")) {
      document.getElementById("employeeList").classList.add("d-none");
      document.getElementById("bulkList").classList.add("d-none");
    }
  });

  function loadQuestionsSection() {
    const evalDate = document.getElementById("evalDate").value;
    const employee = document.getElementById("employee").value.trim();
    const bulk = document.getElementById("bulk").value.trim();

    if (!evalDate || !employee || !bulk) {
      swal("Chú ý", "Vui lòng chọn Ngày, Tên thí sinh và Chủ đề trước khi bắt đầu", "warning");
      return;
    }

    showLoading();
    const script = document.createElement("script");
    script.src = `${WEB_APP_URL}?action=getQuestionsByBulk&bulkName=${encodeURIComponent(bulk)}&callback=handleQuestionsData`;
    script.onerror = () => {
      hideLoading();
      swal("Lỗi", "Không thể tải danh sách câu hỏi", "error");
    };
    document.body.appendChild(script);
  }

  function handleQuestionsData(res) {
    hideLoading();
    if (res && res.status === "SUCCESS") {
      questionsData = res.data || [];
      
      if (questionsData.length === 0) {
        swal("Thông báo", "Không có câu hỏi nào cho chủ đề này.", "info");
        document.getElementById("quizWrap").style.display = "none";
        return;
      }

      userAnswers = {};
      const wrap = document.getElementById("questionsList");
      wrap.innerHTML = "";

      let lastCategory = null;
      questionsData.forEach(q => {
        if (q.category !== lastCategory) {
          const h = document.createElement("div");
          h.className = "section-title";
          h.textContent = q.category;
          wrap.appendChild(h);
          lastCategory = q.category;
        }

        const div = document.createElement("div");
        div.className = "question-item";
        div.id = "q-box-" + q.stt;

        const text = document.createElement("div");
        text.className = "question-text";
        text.textContent = `Câu ${q.stt}: ${q.text}`;
        div.appendChild(text);

        // Render 4 đáp án dạng Checkbox
        q.options.forEach(opt => {
          if (!opt.text) return; // Bỏ qua nếu lựa chọn rỗng

          const label = document.createElement("label");
          label.className = "option-label";

          const checkbox = document.createElement("input");
          checkbox.type = "checkbox";
          checkbox.name = `q_${q.stt}`;
          checkbox.value = opt.key;
          checkbox.onchange = () => onOptionChange(q.stt, div);

          label.appendChild(checkbox);
          label.appendChild(document.createTextNode(`${opt.key}. ${opt.text}`));
          div.appendChild(label);
        });

        if (q.hint) {
          const hintDiv = document.createElement("div");
          hintDiv.className = "question-hint";
          hintDiv.textContent = "💡 Gợi ý: " + q.hint;
          div.appendChild(hintDiv);
        }

        wrap.appendChild(div);
      });

      document.getElementById("quizWrap").style.display = "block";
      document.getElementById("btnLoadCriteria").classList.add("d-none");
      document.getElementById("quizWrap").scrollIntoView({ behavior: "smooth" });

    } else {
      swal("Lỗi", "Không thể tải dữ liệu câu hỏi", "error");
    }
  }

  function onOptionChange(stt, qDiv) {
    qDiv.classList.remove("missing");
    const checkedBoxes = document.querySelectorAll(`input[name="q_${stt}"]:checked`);
    userAnswers[stt] = Array.from(checkedBoxes).map(cb => cb.value);
  }

  function submitQuiz() {
    // Kiểm tra câu hỏi chưa làm (không chọn đáp án nào)
    const missing = questionsData.filter(q => !userAnswers[q.stt] || userAnswers[q.stt].length === 0);

    if (missing.length > 0) {
      missing.forEach(q => {
        const el = document.getElementById("q-box-" + q.stt);
        if (el) el.classList.add("missing");
      });
      swal("Chú ý", `Còn ${missing.length} câu hỏi chưa trả lời!`, "warning");
      document.getElementById("q-box-" + missing[0].stt).scrollIntoView({ behavior: "smooth", block: "center" });
      return;
    }

    const payload = {
      action: "submitQuiz",
      evalDate: document.getElementById("evalDate").value,
      employee: document.getElementById("employee").value.trim(),
      bulk: document.getElementById("bulk").value.trim(),
      userAnswers: userAnswers
    };

    showLoading();
    fetch(WEB_APP_URL, {
      method: "POST",
      body: JSON.stringify(payload)
    })
      .then(res => res.text())
      .then(text => {
        hideLoading();
        const res = JSON.parse(text);
        if (res.status === "SUCCESS") {
          swal("Kết quả làm bài 🏆", res.message, "success").then(() => location.reload());
        } else {
          swal("Lỗi", res.message, "error");
        }
      })
      .catch(err => {
        hideLoading();
        swal("Lỗi mạng", "Mất liên lạc với máy chủ Google Sheets", "error");
      });
  }

  function showLoading() { document.getElementById("loading").classList.remove("d-none"); }
  function hideLoading() { document.getElementById("loading").classList.add("d-none"); }
</script>

</body>
</html>
